# ============================================================
# Production settings for docker-compose.prod.yml
#   cp .env.production.example .env.production
# Never commit .env.production.
# Generate secrets with:  openssl rand -base64 32
# ============================================================

# --- Domain ---
# Store runs at https://DOMAIN, backend + admin at https://api.DOMAIN.
# Point both A records (DOMAIN and api.DOMAIN, plus www) at the VPS IP first.
DOMAIN=example.com
# Let's Encrypt expiry notices go here
ACME_EMAIL=you@example.com

# --- Database ---
POSTGRES_PASSWORD=

# --- Medusa auth secrets ---
JWT_SECRET=
COOKIE_SECRET=

# --- Storefront auth (NextAuth session encryption) ---
NEXTAUTH_SECRET=

# --- Medusa publishable key ---
# Created in the Medusa admin after first boot (Settings -> Publishable API Keys).
# Fill it in, then rebuild the storefront.
MEDUSA_PUBLISHABLE_KEY=

# --- Stripe ---
# Use test keys (pk_test_/sk_test_) until you're ready to take real orders.
STRIPE_PUBLISHABLE_KEY=
STRIPE_API_KEY=
# From Stripe Dashboard -> Developers -> Webhooks, endpoint:
#   https://api.DOMAIN/hooks/payment/stripe_stripe
STRIPE_WEBHOOK_SECRET=

# --- Email (order confirmations, welcome emails) ---
# Leave SMTP_HOST empty to disable. Gmail: turn on 2-Step Verification, then
# create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM="WDIS <you@gmail.com>"
# Optional: gets a copy of every order confirmation.
SMTP_ORDERS_BCC=you@gmail.com
