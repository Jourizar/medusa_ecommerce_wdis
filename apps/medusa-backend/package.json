{
  "name": "@ecommerce/medusa-backend",
  "version": "0.1.0",
  "description": "Medusa.js v2 commerce backend with Stripe",
  "author": "WDIS",
  "license": "MIT",
  "keywords": [
    "medusa",
    "commerce",
    "ecommerce",
    "headless"
  ],
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:art": "medusa exec ./src/scripts/seed-art.ts",
    "setup:checkout": "medusa exec ./src/scripts/setup-checkout.ts",
    "setup:us-store": "medusa exec ./src/scripts/setup-us-store.ts",
    "stripe:listen": "stripe listen --forward-to localhost:9000/hooks/payment/stripe_stripe",
    "db:setup": "medusa db:setup",
    "db:migrate": "medusa db:migrate",
    "migrations:run": "medusa db:migrate",
    "migrations:generate": "medusa db:generate",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.0.0",
    "@medusajs/cli": "^2.0.0",
    "@medusajs/draft-order": "^2.17.2",
    "@medusajs/framework": "^2.0.0",
    "@medusajs/medusa": "^2.0.0",
    "awilix": "^8.0.1",
    "pg": "^8.13.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
