# ============================================================
# Environment Variables Template — Frontend (Storefront)
# Copy this file to .env.local and fill in the values.
# ============================================================

# --- Site ---
# Public URL of the storefront (canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Medusa Backend ---
# Base URL of your running Medusa instance
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# --- Medusa Publishable Key ---
# Required for Store API access. Create it in the Medusa admin:
# Settings -> Publishable API Keys (linked to your sales channel).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key
MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key

# --- Stripe ---
# Publishable key (safe for client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-too
# Your production URL (used for redirects)
NEXTAUTH_URL=http://localhost:3000
